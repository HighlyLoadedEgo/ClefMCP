{
  "name": "clef-mcp",
  "version": "0.1.4",
  "description": "Local MCP server exposing the Clef decision model as a structured clef_decide tool.",
  "type": "module",
  "license": "Apache-2.0",
  "author": "clef-mcp contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HighlyLoadedEgo/ClefMCP.git"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "clef",
    "decision-model",
    "local-inference",
    "llama.cpp"
  ],
  "bin": {
