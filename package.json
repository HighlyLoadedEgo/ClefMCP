    "commander": "^15.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.0",
    "vitest": "^5.0.0"
  }
}
